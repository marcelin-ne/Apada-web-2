---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowLeft } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const photoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png}', {
  eager: true,
});
const coverEntry = Object.entries(photoFiles).find(([path]) => path.endsWith(`/${post.data.coverImage}`));
if (!coverEntry) throw new Error(`Foto de portada no encontrada: ${post.data.coverImage}`);
const cover = coverEntry[1].default;

const CATEGORY_LABELS: Record<string, string> = {
  historias: 'Historias',
  concienciacion: 'Concienciación',
  educacion: 'Educación',
  eventos: 'Eventos',
  derechos: 'Derechos',
};

const dateLabel = post.data.publishDate.toLocaleDateString('es-EC', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article>
    <div class="relative isolate flex min-h-[320px] items-end overflow-hidden sm:min-h-[420px]">
      <Image src={cover} alt="" width={1600} height={700} class="absolute inset-0 -z-20 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-brand-navy/95 via-brand-navy/70 to-brand-navy/30"></div>

      <div class="mx-auto w-full max-w-3xl px-4 pt-24 pb-10 sm:px-6 lg:px-8">
        <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-white/80 hover:text-white">
          <ArrowLeft className="h-4 w-4" aria-hidden="true" /> Volver al blog
        </a>
        <span class="mt-4 inline-flex w-fit rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white ring-1 ring-white/25">
          {CATEGORY_LABELS[post.data.category] ?? post.data.category}
        </span>
        <h1 class="mt-4 text-2xl font-bold tracking-tight text-white sm:text-3xl lg:text-4xl">{post.data.title}</h1>
        <p class="mt-3 text-sm text-white/80">{dateLabel} · {post.data.author}</p>
      </div>
    </div>

    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="prose prose-neutral max-w-none prose-headings:text-foreground prose-p:text-foreground/90">
        <Content />
      </div>

      <a
        href="/blog"
        class="mt-10 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
      >
        <ArrowLeft className="h-4 w-4" aria-hidden="true" /> Ver todos los artículos
      </a>
    </div>
  </article>
</BaseLayout>
