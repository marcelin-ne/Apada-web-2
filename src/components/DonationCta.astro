---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ArrowUpRight } from 'lucide-react';
import { WHATSAPP_URL } from '@/lib/nav';

interface Props {
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image: ImageMetadata;
}

const {
  title = 'Tu ayuda puede cambiar vidas',
  subtitle = 'Cada aporte, por pequeño que sea, hace una diferencia real en la vida de las familias que acompañamos. Escríbenos y súmate al trabajo de APADA.',
  ctaLabel = 'Escríbenos por WhatsApp',
  ctaHref = WHATSAPP_URL,
  image,
} = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-5">
    <div class="relative isolate flex flex-col justify-between overflow-hidden rounded-3xl bg-brand-navy p-8 text-white sm:p-10 lg:col-span-2">
      <svg class="h-10 w-16 text-brand-sky/70" viewBox="0 0 64 40" fill="none" aria-hidden="true">
        <path
          d="M2 32c8 0 8-24 16-24s8 24 16 24 8-24 16-24 8 24 12 24"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
        />
      </svg>

      <h2 class="mt-8 text-2xl font-bold sm:text-3xl">{title}</h2>

      <p class="mt-4 max-w-sm text-sm text-white/75 sm:text-base">{subtitle}</p>

      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex w-fit items-center gap-3 rounded-full bg-white py-1.5 pr-1.5 pl-6 text-sm font-semibold text-brand-navy transition-transform hover:-translate-y-0.5 sm:text-base"
      >
        {ctaLabel}
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-navy text-white">
          <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
        </span>
      </a>
    </div>

    <div class="relative isolate min-h-[280px] overflow-hidden rounded-3xl lg:col-span-3">
      <Image src={image} alt="" width={1000} height={560} class="absolute inset-0 h-full w-full object-cover" />
    </div>
  </div>
</section>
