---
import { Image } from 'astro:assets';
import { MessageCircle } from 'lucide-react';
import logo from '@/assets/brand/logo-white.png';
import bannerImage from '@/assets/photos/equipo-camisetas.jpg';
import SocialIcon from '@/components/icons/SocialIcon.astro';
import { NAV_ITEMS, CONTACT, WHATSAPP_URL, SOCIAL_LINKS } from '@/lib/nav';

const year = new Date().getFullYear();
const footerLinks = NAV_ITEMS.flatMap((item) => item.children ?? [item]);
---

<footer class="border-t border-border bg-brand-navy text-white">
  <div class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 lg:px-8">
    <div class="relative isolate overflow-hidden rounded-3xl">
      <Image src={bannerImage} alt="" width={1400} height={420} class="absolute inset-0 -z-20 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-brand-navy/85"></div>
      <div class="px-6 py-12 text-center sm:px-12 sm:py-14">
        <h2 class="text-2xl font-bold sm:text-3xl">Tu ayuda puede cambiar vidas</h2>
        <p class="mx-auto mt-3 max-w-xl text-white/85">
          Cada aporte, por pequeño que sea, hace una diferencia real en la vida de las familias que
          acompañamos. Escríbenos y súmate al trabajo de APADA.
        </p>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-white py-1.5 pr-1.5 pl-6 text-base font-semibold text-brand-navy transition-transform hover:-translate-y-0.5"
        >
          <MessageCircle className="h-4 w-4" aria-hidden="true" />
          Escríbenos por WhatsApp
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-navy text-white">
            <MessageCircle className="h-4 w-4" aria-hidden="true" />
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 lg:col-span-1">
        <Image src={logo} alt="APADA del Ecuador" height={40} width={73} class="h-10 w-auto" />
        <p class="mt-4 max-w-xs text-sm text-white/70">
          Somos padres que ayudan a padres en el camino del autismo.
        </p>
        <div class="mt-5 flex gap-3">
          {SOCIAL_LINKS.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
            >
              <SocialIcon name={social.icon} class="h-4 w-4" />
            </a>
          ))}
        </div>
      </div>

      <nav aria-label="Mapa del sitio">
        <h2 class="text-sm font-semibold tracking-wide text-white/90 uppercase">Navegación</h2>
        <ul class="mt-4 space-y-2">
          {footerLinks.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-white/70 transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-semibold tracking-wide text-white/90 uppercase">Contacto</h2>
        <ul class="mt-4 space-y-2 text-sm text-white/70">
          <li>{CONTACT.address}</li>
          <li>
            <a href={`tel:${CONTACT.phone.replace(/\s+/g, '')}`} class="hover:text-white">{CONTACT.phone}</a>
          </li>
          <li>
            <a href={`mailto:${CONTACT.email}`} class="hover:text-white">{CONTACT.email}</a>
          </li>
          <li>
            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="font-semibold text-white underline underline-offset-2 hover:text-white/80">
              Escríbenos por WhatsApp
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold tracking-wide text-white/90 uppercase">Síguenos</h2>
        <ul class="mt-4 space-y-2 text-sm text-white/70">
          {SOCIAL_LINKS.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener noreferrer" class="hover:text-white">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-center text-xs text-white/50 sm:text-left">
      © {year} APADA del Ecuador. Todos los derechos reservados.
    </div>
  </div>
</footer>
