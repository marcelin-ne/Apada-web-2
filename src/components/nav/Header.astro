---
import { Image } from 'astro:assets';
import { MessageCircle } from 'lucide-react';
import logoWhite from '@/assets/brand/logo-white.png';
import logoNavy from '@/assets/brand/logo-navy.png';
import DesktopNav from '@/components/nav/DesktopNav.tsx';
import MobileMenu from '@/components/nav/MobileMenu.tsx';
import { NAV_ITEMS, WHATSAPP_URL } from '@/lib/nav';

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  data-scrolled="false"
  class="group fixed inset-x-0 top-0 z-50 transition-colors duration-300 group-data-[scrolled=true]:border-b group-data-[scrolled=true]:border-border data-[scrolled=true]:border-b data-[scrolled=true]:border-border data-[scrolled=true]:bg-background/90 data-[scrolled=true]:shadow-sm data-[scrolled=true]:backdrop-blur"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="my-3 flex h-14 items-center justify-between gap-4 rounded-full bg-white/10 px-3 text-white ring-1 ring-white/20 backdrop-blur-md transition-all duration-300 sm:px-5 group-data-[scrolled=true]:my-0 group-data-[scrolled=true]:h-16 group-data-[scrolled=true]:rounded-none group-data-[scrolled=true]:bg-transparent group-data-[scrolled=true]:text-foreground group-data-[scrolled=true]:ring-0 group-data-[scrolled=true]:backdrop-blur-none"
    >
      <a href="/" class="relative flex h-9 w-17.5 shrink-0 items-center sm:h-10" aria-label="APADA del Ecuador — Inicio">
        <Image
          src={logoWhite}
          alt="APADA del Ecuador"
          height={40}
          width={73}
          class="absolute inset-0 h-full w-full object-contain object-left opacity-100 transition-opacity duration-300 group-data-[scrolled=true]:opacity-0"
        />
        <Image
          src={logoNavy}
          alt="APADA del Ecuador"
          height={40}
          width={73}
          class="absolute inset-0 h-full w-full object-contain object-left opacity-0 transition-opacity duration-300 group-data-[scrolled=true]:opacity-100"
        />
      </a>

      <DesktopNav client:idle items={NAV_ITEMS} currentPath={currentPath} />

      <div class="flex items-center gap-2">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden items-center gap-1.5 rounded-full bg-brand-blue px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-blue-light md:inline-flex"
        >
          <MessageCircle className="h-4 w-4" aria-hidden="true" />
          WhatsApp
        </a>
        <MobileMenu client:idle items={NAV_ITEMS} currentPath={currentPath} whatsappUrl={WHATSAPP_URL} />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    if (!header) return;
    let scrolled;
    const onScroll = () => {
      const next = window.scrollY > 12 ? 'true' : 'false';
      if (next === scrolled) return;
      scrolled = next;
      header.dataset.scrolled = next;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
